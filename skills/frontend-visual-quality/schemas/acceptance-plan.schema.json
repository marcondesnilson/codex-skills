{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frontend_impact", "components", "checks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "frontend_impact": {"type": "boolean"},
    "components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "category", "required", "description"], "properties": {"id": {"type": "string"}, "category": {"type": "string"}, "required": {"type": "boolean"}, "description": {"type": "string", "minLength": 1}}}}
  }
}
