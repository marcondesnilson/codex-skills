{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frontend_impact",
    "components",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "frontend_impact": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "required",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "not": {
              "const": "external_visual_review"
            }
          },
          "category": {
            "enum": [
              "STATIC",
              "UNIT",
              "FEATURE",
              "INTEGRATION",
              "DATABASE",
              "API",
              "UI",
              "UX",
              "VISUAL",
              "ACCESSIBILITY",
              "FORMS",
              "LOADING",
              "ERROR",
              "EMPTY",
              "E2E",
              "SECURITY",
              "BUILD",
              "RUNTIME",
              "SMOKE",
              "REGRESSION"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
